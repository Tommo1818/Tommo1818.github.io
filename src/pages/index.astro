---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  site,
  links,
  experience,
  education,
  earlierEducation,
  skillGroups,
  posts,
  outside,
  music,
} from '../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((entry) => entry.data.featured);

const parseStat = (raw: string) => {
  const m = raw.match(/^(\d+(?:\.\d+)?)(.*)$/);
  if (!m) return { count: null, decimals: 0, suffix: '' };
  const numStr = m[1];
  const dot = numStr.indexOf('.');
  return {
    count: numStr,
    decimals: dot >= 0 ? numStr.length - dot - 1 : 0,
    suffix: m[2] ?? '',
  };
};
---

<Base>
  <!-- ───────────────────────── Hero ───────────────────────── -->
  <section class="hero">
    <HeroCanvas />
    <div class="wrap hero-content">
      <p class="hero-kicker hero-enter" style="--enter-i: 0">Data · Software · Hardware · Making</p>
      <h1 class="hero-enter" style="--enter-i: 1">
        <span class="grad">{site.name}</span>
      </h1>
      <p class="hero-lede hero-enter" style="--enter-i: 2">
        I take systems apart, work out how they tick, and ship tools that make them better —
        whether that is a <strong>data pipeline</strong>, a <strong>firmware protocol</strong>,
        or a <strong>drawer full of Gridfinity</strong>.
      </p>

      <div class="hero-actions hero-enter" style="--enter-i: 3">
        <span class="pill">{site.availability}</span>
      </div>

      <div class="hero-actions hero-enter" style="--enter-i: 4">
        <a class="btn btn--primary" href="#work">
          See the work
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="btn" href={links.github} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          GitHub
        </a>
        <a class="btn" href={links.linkedin} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S.02 4.88.02 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5ZM.5 8h4v15h-4V8Zm7.5 0h3.8v2.05h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V23h-4v-7.9c0-1.88-.03-4.3-2.62-4.3-2.63 0-3.03 2.05-3.03 4.16V23h-4V8Z"/></svg>
          LinkedIn
        </a>
        <button class="btn" type="button" data-print>Download CV</button>
      </div>

      <div class="hero-meta hero-enter" style="--enter-i: 5">
        <span><b>Geospatial Data Engineer</b> · Aspia Space</span>
        <span><b>MSc Data Science</b> · Bristol, 2026–27</span>
        <span><b>BSc Computer Science (2:1)</b> · Swansea</span>
        <span><b>Technical Support</b> · Options Technology</span>
      </div>

      <p class="print-contact">
        tommo1818.github.io · linkedin.com/in/tom-vernon-7442b0197 · github.com/Tommo1818
      </p>
    </div>
  </section>

  <!-- ───────────────────────── About ───────────────────────── -->
  <section class="section" id="about">
    <div class="wrap about-grid" data-reveal>
      <div>
        <p class="eyebrow">01 — About</p>
        <h2 class="section-title">A builder&rsquo;s range, with a data science spine.</h2>
      </div>
      <div class="about-body">
        <p>
          I started stripping down and salvaging electronics in Jersey before studying Computer
          Science (2:1) at Swansea. After a year on first- and second-line technical support at
          Options Technology in London, I joined Aspia Space as a Geospatial Data Engineer Intern
          and stepped up to Geospatial Data Engineer — now alongside an MSc in Data Science at
          Bristol. That path left me equally at home debugging someone&rsquo;s laptop at 9am and
          reasoning about data pipelines or evaluation metrics at 9pm.
        </p>
        <p>
          Outside work I build things: a browser tool that generates printer-ready{' '}
          <a href="/work/gridfinity/">Gridfinity baseplates</a>, a{' '}
          <a href="/work/macropad/">WebHID configurator</a> for a macropad whose vendor
          software does not work, and a{' '}
          <a href="/work/home-server/">self-hosted home server</a> that has to be reliable
          enough for other people to depend on. My dissertation applied deep learning to
          toxicity in real Counter-Strike chat and evaluated it with human raters — the first
          time I properly learned that the hard part is not the model.
        </p>
        <p>
          I also make house music, play more Counter-Strike and osu! than is strictly healthy,
          build PCs for people, and write about{' '}
          <a href={links.blog} target="_blank" rel="noopener noreferrer">anime pilgrimages in Japan</a>.
          The common thread is not &ldquo;tech&rdquo; — it is wanting to understand a system well
          enough to make something good with it.
        </p>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Work ───────────────────────── -->
  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">02 — Selected work</p>
        <h2 class="section-title">Things I built, and what was hard about them.</h2>
        <p class="section-lede">
          Not a repository list. Each one starts with a problem I actually had, and ends with
          the part that turned out to be the real work. Interact with the diagrams below or open
          each case study.
        </p>
      </div>

      <div class="work-grid">
        {featured.map((entry, i) => <ProjectCard entry={entry} index={i + 1} />)}
      </div>

      <div class="writing-foot">
        <span>More experiments, coursework and half-finished ideas live on GitHub.</span>
        <a class="btn" href={links.github} target="_blank" rel="noopener noreferrer">All repositories ↗</a>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Experience ───────────────────────── -->
  <section class="section" id="experience">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">03 — Experience &amp; education</p>
        <h2 class="section-title">From hardware benches to geospatial pipelines — and going deeper.</h2>
      </div>

      <p class="tl-group-label" data-reveal>Experience</p>
      <div class="timeline">
        {experience.map((item, idx) => {
          const isCurrent =
            item.when.includes('Present') || Boolean(item.subRoles?.some((sr) => sr.current));
          return (
            <article class="tl-item" data-reveal data-delay={String(idx * 65)}>
              <div class="tl-when">
                <span
                  class={`tl-node ${isCurrent ? 'tl-node--current' : ''}`}
                  aria-hidden="true"
                />
                <span>{item.when}</span>
              </div>
              <div>
                <div class="tl-role">
                  <span>{item.role}</span>
                  {item.grade && <span class="tl-grade">{item.grade}</span>}
                </div>
                {item.org && (
                  <div class="tl-org">
                    {item.org}
                    {item.location && <span class="tl-loc"> · {item.location}</span>}
                  </div>
                )}

                {item.subRoles && item.subRoles.length > 0 && (
                  <ul class="tl-subroles" aria-label="Role progression">
                    {item.subRoles.map((sr) => (
                      <li class={sr.current ? 'is-current' : ''}>
                        <strong>{sr.role}</strong>
                        <span>{sr.when}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {item.blurb && <p class="tl-note">{item.blurb}</p>}
                {item.points && item.points.length > 0 && (
                  <ul>
                    {item.points.map((point) => <li>{point}</li>)}
                  </ul>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <p class="tl-group-label tl-group-label--gap" data-reveal>Education</p>
      <div class="timeline">
        {education.map((item, idx) => (
          <article class="tl-item" data-reveal data-delay={String(idx * 65)}>
            <div class="tl-when">
              <span class="tl-node" aria-hidden="true" />
              <span>{item.when}</span>
            </div>
            <div>
              <div class="tl-role">
                <span>{item.role}</span>
                {item.grade && <span class="tl-grade">{item.grade}</span>}
              </div>
              <div class="tl-org">
                {item.org}
                {item.location && <span class="tl-loc"> · {item.location}</span>}
              </div>
              {item.blurb && <p class="tl-note">{item.blurb}</p>}
              {item.activities && item.activities.length > 0 && (
                <div class="tl-activities" aria-label="Activities and societies">
                  <span class="tl-act-label">Societies:</span>
                  {item.activities.map((act) => <span class="chip">{act}</span>)}
                </div>
              )}
              {item.link && (
                <p class="tl-note tl-link">
                  <a href={item.link.href} target="_blank" rel="noopener noreferrer">
                    {item.link.label} ↗
                  </a>
                </p>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="tl-earlier" data-reveal>
        <span class="tl-earlier-label">Earlier schooling</span>
        <div class="tl-earlier-list">
          {earlierEducation.map((school, i) => (
            <span>
              {i > 0 && <span class="tl-sep" aria-hidden="true"> · </span>}
              <b>{school.school}</b> ({school.when})
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Skills ───────────────────────── -->
  <section class="section" id="skills">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">04 — Toolkit</p>
        <h2 class="section-title">What I work with.</h2>
        <p class="section-lede">
          Grouped by where it shows up, not by confidence percentages. Every line here has a
          project behind it.
        </p>
      </div>

      <div class="skills">
        {skillGroups.map((group, i) => (
          <div class="skill" data-spotlight data-reveal data-delay={String(i * 55)}>
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Music ───────────────────────── -->
  <section class="section" id="music">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">05 — Music</p>
        <h2 class="section-title">{music.headline}</h2>
        <p class="section-lede" set:html={music.blurb} />
      </div>

      <div class="music-grid" data-reveal data-delay="60">
        <a class="release-hero" href={music.latest.href} target="_blank" rel="noopener noreferrer">
          <img
            src={music.art}
            alt={`Cover art for ${music.latest.title}`}
            width="640"
            height="640"
          />
          <div class="release-hero-body">
            <span class="release-kicker-row">
              <span class="eq-bars" aria-hidden="true">
                <i></i><i></i><i></i><i></i>
              </span>
              <span class="card-kicker">Latest release</span>
            </span>
            <strong>{music.latest.title}</strong>
            <span class="release-hero-cta">Play on Spotify ↗</span>
          </div>
        </a>

        <div>
          <div class="stat-band">
            {music.stats.map((stat) => {
              const parsed = parseStat(stat.value);
              return (
                <div>
                  <b
                    data-count={parsed.count ?? undefined}
                    data-decimals={String(parsed.decimals)}
                    data-suffix={parsed.suffix}
                  >
                    {stat.value}
                  </b>
                  <span>{stat.label}</span>
                </div>
              );
            })}
          </div>

          <ul class="release-list">
            {music.releases.map((release) => (
              <li>
                <span class="r-title">{release.title}</span>
                <span class="r-year">{release.year}</span>
                <span class="r-note">{release.note}</span>
              </li>
            ))}
          </ul>

          <div class="link-row">
            {music.links.map((link) => (
              <a class="chip" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Writing ───────────────────────── -->
  <section class="section" id="writing">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">06 — Writing &amp; travel</p>
        <h2 class="section-title">Anime pilgrimages, documented.</h2>
        <p class="section-lede">
          A travel blog that has quietly accumulated 27,000+ reads: real trips to the places
          behind the shows, photographed and written up properly.
        </p>
      </div>

      <div class="writing">
        {posts.map((post, i) => (
          <a
            class="post"
            href={post.href}
            target="_blank"
            rel="noopener noreferrer"
            data-spotlight
            data-reveal
            data-delay={String(i * 70)}
          >
            <span class="tag">{post.tag}</span>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <span class="date">{post.date}</span>
          </a>
        ))}
      </div>

      <div class="writing-foot">
        <span>Yuru Camp · Hibike Euphonium · Tsuki ga Kirei · and more</span>
        <a class="btn" href={links.blog} target="_blank" rel="noopener noreferrer">tomsblog.data.blog ↗</a>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Outside ───────────────────────── -->
  <section class="section" id="outside">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">07 — Outside the terminal</p>
        <h2 class="section-title">The rest of it.</h2>
      </div>

      <div class="outside">
        {outside.map((item, i) => (
          <div class="outside-item" data-spotlight data-reveal data-delay={String(i * 70)}>
            <h3>{item.title}</h3>
            <p set:html={item.body} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Contact ───────────────────────── -->
  <section class="contact" id="contact">
    <div class="wrap" data-reveal>
      <p class="eyebrow" style="justify-content:center">08 — Contact</p>
      <h2>Want to build something?</h2>
      <p>
        I am open to data, software and engineering roles, and always interested in a project
        that needs someone comfortable across the stack.
      </p>
      <div class="contact-actions">
        <a class="btn btn--primary" href={links.contact} target="_blank" rel="noopener noreferrer">Get in touch</a>
        <a class="btn" href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="btn" href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="btn" href={links.blog} target="_blank" rel="noopener noreferrer">Blog</a>
        <button class="btn" type="button" data-print>Download CV</button>
      </div>
    </div>
  </section>
</Base>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-print]')
    .forEach((button) => button.addEventListener('click', () => window.print()));
</script>
