---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, links, posts, music } from '../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((entry) => entry.data.featured);

const parseStat = (raw: string) => {
  const m = raw.match(/^(\d+(?:\.\d+)?)(.*)$/);
  if (!m) return { count: null, decimals: 0, suffix: '' };
  const numStr = m[1];
  const dot = numStr.indexOf('.');
  return {
    count: numStr,
    decimals: dot >= 0 ? numStr.length - dot - 1 : 0,
    suffix: m[2] ?? '',
  };
};

const tools = ['Python', 'TypeScript', 'SQL', 'Docker', 'Linux', 'ESP32', 'Astro'];
---

<Base>
  <!-- ───────────────────────── Launchpad ───────────────────────── -->
  <section class="hero">
    <HeroCanvas />
    <div class="wrap hero-content">
      <div class="hero-head">
        <div class="hero-enter" style="--enter-i: 0">
          <span class="pill">{site.availability}</span>
        </div>
        <p class="hero-kicker hero-enter" style="--enter-i: 1">Data · Hardware · Sound</p>
        <h1 class="hero-enter" style="--enter-i: 1">
          <span class="grad">{site.name}</span>
        </h1>
        <p class="hero-lede hero-enter" style="--enter-i: 2">
          Geospatial data engineer &amp; builder in Bristol. I make{' '}
          <strong>data pipelines</strong>, <strong>hardware</strong>, and <strong>house records</strong>.
        </p>
      </div>

      <div class="launchpad">
        <a class="launch-tile hero-enter" style="--enter-i: 3; --tile-accent: #a78bfa" href="#work" data-spotlight>
          <span class="launch-tile-top">
            <span class="launch-tile-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none">
                <rect x="6" y="6" width="20" height="20" rx="4" stroke="currentColor" stroke-width="1.5" />
                <path d="M6 15 H13 V11 H19 V21 H26" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                <circle cx="13" cy="11" r="1.6" fill="currentColor" />
                <circle cx="19" cy="21" r="1.6" fill="currentColor" />
              </svg>
            </span>
            <span class="launch-tile-arrow" aria-hidden="true">→</span>
          </span>
          <span class="launch-tile-title">Builds</span>
          <span class="launch-tile-hook">Data tools, hardware and research — live where they run.</span>
          <span class="launch-tile-meta">4 builds · 2 live tools</span>
        </a>

        <a class="launch-tile hero-enter" style="--enter-i: 4; --tile-accent: #f472b6" href="#sound" data-spotlight>
          <span class="launch-tile-top">
            <span class="launch-tile-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none">
                <path d="M4 21 V13 M9 25 V8 M14 20 V12 M19 26 V6 M24 18 V14 M29 22 V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </span>
            <span class="launch-tile-arrow" aria-hidden="true">→</span>
          </span>
          <span class="launch-tile-title">Sound</span>
          <span class="launch-tile-hook">Deep &amp; lo-fi house on Lost Palms and friends.</span>
          <span class="launch-tile-meta">13k+ monthly listeners</span>
        </a>

        <a class="launch-tile hero-enter" style="--enter-i: 5; --tile-accent: #fbbf24" href="#japan" data-spotlight>
          <span class="launch-tile-top">
            <span class="launch-tile-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none">
                <path d="M5 26 C11 22 17 16 21 10 C23 7 26 7 26 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="2 3" />
                <circle cx="8" cy="24" r="2" fill="currentColor" />
                <circle cx="26" cy="5" r="2.4" stroke="currentColor" stroke-width="1.6" />
              </svg>
            </span>
            <span class="launch-tile-arrow" aria-hidden="true">→</span>
          </span>
          <span class="launch-tile-title">Japan</span>
          <span class="launch-tile-hook">Anime pilgrimages and mountain trains, on foot.</span>
          <span class="launch-tile-meta">27k+ reads</span>
        </a>

        <a class="launch-tile hero-enter" style="--enter-i: 6; --tile-accent: #4ade80" href="#play" data-spotlight>
          <span class="launch-tile-top">
            <span class="launch-tile-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none">
                <circle cx="16" cy="16" r="9" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.6" />
                <circle cx="16" cy="16" r="3" fill="currentColor" fill-opacity="0.25" stroke="currentColor" stroke-width="1.5" />
                <path d="M16 3 V8 M16 24 V29 M3 16 H8 M24 16 H29" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </span>
            <span class="launch-tile-arrow" aria-hidden="true">→</span>
          </span>
          <span class="launch-tile-title">Play</span>
          <span class="launch-tile-hook">Counter-Strike, osu! and custom PCs for other people.</span>
          <span class="launch-tile-meta">Top 30 UK · FACEIT Lv. 9</span>
        </a>
      </div>

      <div class="now-strip" data-reveal>
        <span class="now-label">Now</span>
        <a href="#about">Geospatial Data Engineer @ Aspia Space</a>
        <span class="now-sep" aria-hidden="true">/</span>
        <a href={`/work/${work[0].id}/`}>Building {work[0].data.title}</a>
        <span class="now-sep" aria-hidden="true">/</span>
        <a href={music.latest.href} target="_blank" rel="noopener noreferrer">Playing {music.latest.title}</a>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Builds ───────────────────────── -->
  <section class="section" id="work">
    <div class="wrap">
      <div class="room-head" data-reveal>
        <p class="room-label" style="--room-accent: #a78bfa">Builds</p>
        <h2 class="section-title">Things I&rsquo;ve built.</h2>
        <p class="section-lede">Four projects, live where they run. The diagrams are interactive — poke at them.</p>
      </div>

      <div class="work-grid">
        {featured.map((entry, i) => <ProjectCard entry={entry} index={i + 1} />)}
      </div>

      <div class="section-foot">
        <a class="btn" href={links.github} target="_blank" rel="noopener noreferrer">All repositories ↗</a>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Sound ───────────────────────── -->
  <section class="section" id="sound">
    <div class="wrap">
      <div class="room-head" data-reveal>
        <p class="room-label" style="--room-accent: #f472b6">Sound</p>
        <h2 class="section-title">{music.headline}</h2>
        <p class="section-lede" set:html={music.blurb} />
      </div>

      <div class="music-grid" data-reveal data-delay="60">
        <div class="release-wrap">
          <div class="release-aura" aria-hidden="true"></div>
          <a class="release-hero" href={music.latest.href} target="_blank" rel="noopener noreferrer">
            <img
              src={music.art}
              alt={`Cover art for ${music.latest.title}`}
              width="640"
              height="640"
            />
            <span class="release-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                <path d="M8 5.14v14l11-7-11-7z" />
              </svg>
            </span>
            <div class="release-hero-body">
              <span class="release-kicker-row">
                <span class="eq-bars" aria-hidden="true">
                  <i></i><i></i><i></i><i></i>
                </span>
                <span class="card-kicker">Latest release</span>
              </span>
              <strong>{music.latest.title}</strong>
              <span class="release-hero-cta">Play on Spotify ↗</span>
            </div>
          </a>
        </div>

        <div>
          <div class="stat-band">
            {music.stats.map((stat) => {
              const parsed = parseStat(stat.value);
              return (
                <div>
                  <b
                    data-count={parsed.count ?? undefined}
                    data-decimals={String(parsed.decimals)}
                    data-suffix={parsed.suffix}
                  >
                    {stat.value}
                  </b>
                  <span>{stat.label}</span>
                </div>
              );
            })}
          </div>

          <ul class="release-list">
            {music.releases.map((release) => (
              <li>
                <span class="r-title">{release.title}</span>
                <span class="r-year">{release.year}</span>
                <span class="r-note">{release.note}</span>
              </li>
            ))}
          </ul>

          <div class="link-row">
            {music.links.map((link) => (
              <a class="chip" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
            ))}
          </div>

          <p class="sound-teaching">
            <span class="sound-teaching-label">Teaching</span>
            Music production lessons — one-to-one or small group.
            <a href="#contact">Ask about lessons ↗</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Japan ───────────────────────── -->
  <section class="section" id="japan">
    <div class="wrap">
      <div class="room-head" data-reveal>
        <p class="room-label" style="--room-accent: #fbbf24">Field notes</p>
        <h2 class="section-title">Japan, on foot.</h2>
        <p class="section-lede">Anime pilgrimages, mountain trains and 27,000+ reads from real trips.</p>
      </div>

      <div class="japan-route" data-reveal>
        <span class="japan-route-label">Route so far</span>
        <a class="japan-pin" href={posts[2].href} target="_blank" rel="noopener noreferrer">Kawagoe</a>
        <span class="japan-arrow" aria-hidden="true">→</span>
        <a class="japan-pin" href={posts[1].href} target="_blank" rel="noopener noreferrer">Uji</a>
        <span class="japan-arrow" aria-hidden="true">→</span>
        <a class="japan-pin" href={posts[0].href} target="_blank" rel="noopener noreferrer">Yamanashi</a>
        <span class="japan-route-links">
          <a href={links.blog} target="_blank" rel="noopener noreferrer">Read the blog ↗</a>
          <a href={links.polarsteps} target="_blank" rel="noopener noreferrer">Trip map ↗</a>
        </span>
      </div>

      <div class="writing">
        {posts.map((post, i) => (
          <a
            class="post"
            href={post.href}
            target="_blank"
            rel="noopener noreferrer"
            data-spotlight
            data-reveal
            data-delay={String(i * 65)}
          >
            <div class="post-art" aria-hidden="true">
              {post.theme === 'yuru' && (
                <svg viewBox="0 0 320 110" width="320" height="110">
                  <defs>
                    <linearGradient id="post-yuru-sky" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#1d1836" />
                      <stop offset="100%" stop-color="#0b1526" />
                    </linearGradient>
                  </defs>
                  <rect width="320" height="110" fill="url(#post-yuru-sky)" />
                  <circle cx="52" cy="26" r="1.4" fill="#c4b1ff" opacity="0.8" />
                  <circle cx="96" cy="18" r="1" fill="#7dd3fc" opacity="0.7" />
                  <circle cx="248" cy="24" r="1.3" fill="#c4b1ff" opacity="0.75" />
                  <circle cx="282" cy="36" r="1" fill="#fde68a" opacity="0.8" />
                  <path d="M18 110 L118 46 L154 68 L208 22 L272 78 L308 110 Z" fill="#13162a" stroke="#38bdf8" stroke-opacity="0.3" />
                  <path d="M194 34 L208 22 L222 36 L213 40 L205 34 Z" fill="#e2e8f0" fill-opacity="0.22" />
                  <polygon points="82,98 98,74 114,98" fill="#fbbf24" fill-opacity="0.26" stroke="#fbbf24" stroke-width="1.3" />
                  <circle cx="98" cy="92" r="10" fill="#fbbf24" fill-opacity="0.14" />
                </svg>
              )}
              {post.theme === 'hibike' && (
                <svg viewBox="0 0 320 110" width="320" height="110">
                  <defs>
                    <linearGradient id="post-hibike-sky" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#1b142c" />
                      <stop offset="100%" stop-color="#17233a" />
                    </linearGradient>
                  </defs>
                  <rect width="320" height="110" fill="url(#post-hibike-sky)" />
                  <circle cx="245" cy="38" r="18" fill="#fbbf24" fill-opacity="0.16" />
                  <circle cx="245" cy="38" r="9" fill="#fde68a" fill-opacity="0.35" />
                  <path d="M0 78 Q80 68 160 72 Q240 76 320 68 L320 110 L0 110 Z" fill="#0d1829" />
                  <path d="M24 72 Q160 44 296 72" fill="none" stroke="#a78bfa" stroke-width="2" />
                  <line x1="78" y1="60" x2="78" y2="80" stroke="#7dd3fc" stroke-opacity="0.5" stroke-width="1.5" />
                  <line x1="160" y1="54" x2="160" y2="82" stroke="#7dd3fc" stroke-opacity="0.5" stroke-width="1.5" />
                  <line x1="242" y1="60" x2="242" y2="80" stroke="#7dd3fc" stroke-opacity="0.5" stroke-width="1.5" />
                  <line x1="210" y1="92" x2="275" y2="92" stroke="#fbbf24" stroke-opacity="0.35" stroke-dasharray="6 4" />
                </svg>
              )}
              {post.theme === 'tsuki' && (
                <svg viewBox="0 0 320 110" width="320" height="110">
                  <defs>
                    <linearGradient id="post-tsuki-sky" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#1a132c" />
                      <stop offset="100%" stop-color="#1f162c" />
                    </linearGradient>
                  </defs>
                  <rect width="320" height="110" fill="url(#post-tsuki-sky)" />
                  <circle cx="238" cy="32" r="14" fill="#e9d5ff" fill-opacity="0.22" stroke="#c4b1ff" stroke-opacity="0.5" />
                  <rect x="136" y="28" width="38" height="82" fill="#12121f" stroke="#47476b" />
                  <polygon points="128,32 155,14 182,32" fill="#1d1b30" stroke="#a78bfa" stroke-opacity="0.65" />
                  <polygon points="131,52 155,40 179,52" fill="#1a182b" stroke="#6366f1" stroke-opacity="0.45" />
                  <rect x="148" y="64" width="14" height="16" rx="2" fill="#f472b6" fill-opacity="0.35" />
                  <rect x="64" y="62" width="56" height="48" fill="#0f0f19" stroke="#2c2c42" />
                  <rect x="192" y="58" width="66" height="52" fill="#0f0f19" stroke="#2c2c42" />
                </svg>
              )}
            </div>
            <div class="post-body">
              <span class="tag">{post.tag}</span>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <span class="date">{post.date}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="section-foot">
        <a class="btn" href={links.blog} target="_blank" rel="noopener noreferrer">All field notes ↗</a>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── Play ───────────────────────── -->
  <section class="section" id="play">
    <div class="wrap">
      <div class="room-head" data-reveal>
        <p class="room-label" style="--room-accent: #4ade80">Play</p>
        <h2 class="section-title">After hours.</h2>
        <p class="section-lede">Competitive games, custom PCs, and the occasional rabbit hole.</p>
      </div>

      <div class="play-grid">
        <article class="play-card" data-spotlight data-reveal>
          <span class="play-icon" aria-hidden="true">
            <svg viewBox="0 0 36 36" fill="none">
              <circle cx="18" cy="18" r="11" stroke="#4ade80" stroke-width="1.5" stroke-opacity="0.7" />
              <circle cx="18" cy="18" r="3.5" fill="#4ade80" fill-opacity="0.25" stroke="#4ade80" stroke-width="1.5" />
              <path d="M18 3 V9 M18 27 V33 M3 18 H9 M27 18 H33" stroke="#4ade80" stroke-width="1.5" />
            </svg>
          </span>
          <span class="play-kicker">Counter-Strike</span>
          <b class="play-stat">Top 30 UK</b>
          <p>Ex-Swansea uni team. Peaked 7th together — FACEIT Lv. 9.</p>
        </article>

        <article class="play-card" data-spotlight data-reveal data-delay="70">
          <span class="play-icon" aria-hidden="true">
            <svg viewBox="0 0 36 36" fill="none">
              <circle cx="15" cy="15" r="8" stroke="#f472b6" stroke-width="1.5" />
              <path d="M21 21 L31 31" stroke="#f472b6" stroke-width="1.5" stroke-linecap="round" />
              <circle cx="15" cy="15" r="2.5" fill="#f472b6" fill-opacity="0.35" />
            </svg>
          </span>
          <span class="play-kicker">osu!</span>
          <b class="play-stat">5-digit global</b>
          <p>Mouse and keyboard. No tablet, no excuses.</p>
        </article>

        <article class="play-card" data-spotlight data-reveal data-delay="140">
          <span class="play-icon" aria-hidden="true">
            <svg viewBox="0 0 36 36" fill="none">
              <rect x="9" y="5" width="18" height="26" rx="3" stroke="#38bdf8" stroke-width="1.5" />
              <path d="M14 11 H22 M14 16 H22 M14 21 H19" stroke="#38bdf8" stroke-width="1.5" stroke-linecap="round" />
              <circle cx="18" cy="27" r="1.4" fill="#38bdf8" />
            </svg>
          </span>
          <span class="play-kicker">PC building</span>
          <b class="play-stat">BIOS to drivers</b>
          <p>Custom rigs for other people — spec&rsquo;d, built and supported.</p>
        </article>
      </div>

      <p class="play-note" data-reveal>
        Current rotation: Counter-Strike · osu! · whatever the group chat is playing.
      </p>
    </div>
  </section>

  <!-- ───────────────────────── About ───────────────────────── -->
  <section class="section" id="about">
    <div class="wrap about-grid">
      <div class="about-copy" data-reveal>
        <p class="room-label" style="--room-accent: #fbbf24">About</p>
        <h2 class="section-title">The long way round.</h2>
        <p>
          I started by taking electronics apart in Jersey, then moved to Swansea for a computer
          science degree. A year of live finance support in London taught me how to stay calm
          when systems break.
        </p>
        <p>
          Now I build Earth-observation pipelines at Aspia Space and study data science at
          Bristol. The rest of the time goes on hardware, house records and the next Japan trip.
        </p>
        <div class="about-route" aria-label="Route so far">
          <span>Jersey</span><i aria-hidden="true">→</i>
          <span>Swansea</span><i aria-hidden="true">→</i>
          <span>London</span><i aria-hidden="true">→</i>
          <span class="is-now">Aspia Space</span><i aria-hidden="true">→</i>
          <span>Bristol</span>
        </div>
        <a class="btn" href="/cv">CV &amp; experience ↗</a>
      </div>

      <aside class="about-panel" data-spotlight data-reveal data-delay="80">
        <div class="about-row"><span>Now</span><b>Geospatial Data Engineer @ Aspia Space</b></div>
        <div class="about-row"><span>Studying</span><b>MSc Data Science, University of Bristol</b></div>
        <div class="about-row"><span>Based</span><b>Bristol / Jersey</b></div>
        <div class="about-row"><span>Elsewhere</span><a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div>
        <div class="about-tools">
          {tools.map((tool) => <span class="chip">{tool}</span>)}
        </div>
      </aside>
    </div>
  </section>

  <!-- ───────────────────────── Contact ───────────────────────── -->
  <section class="contact" id="contact">
    <div class="wrap" data-reveal>
      <div class="contact-card" data-spotlight>
        <p class="room-label" style="justify-content: center; --room-accent: #4ade80">Contact</p>
        <h2>Let&rsquo;s make something.</h2>
        <p>Open to data, software and engineering roles — or a good side project.</p>
        <div class="contact-actions">
          <a class="btn btn--primary" href={links.contact} target="_blank" rel="noopener noreferrer">Get in touch</a>
          <a class="btn" href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="btn" href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="btn" href="/cv">CV</a>
          <a class="btn" href={links.blog} target="_blank" rel="noopener noreferrer">Blog</a>
        </div>
      </div>
    </div>
  </section>
</Base>
