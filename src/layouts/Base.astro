---
import '../styles/global.css';
import { site, links } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.role}`,
  description = site.tagline,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

const onCv = Astro.url.pathname.replace(/\/$/, '') === '/cv';
const navCtaHref = onCv ? links.contact : '/cv';
const navCtaLabel = onCv ? 'Get in touch' : 'Open to roles';
const navCtaShort = onCv ? 'Contact' : 'CV';

const sameAs = [links.github, links.linkedin, links.music, links.blog].filter(Boolean);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'Geospatial Data Engineer & MSc Data Science Student',
  description: site.tagline,
  worksFor: { '@type': 'Organization', name: 'Aspia Space' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Swansea University' },
    { '@type': 'CollegeOrUniversity', name: 'University of Bristol' },
  ],
  knowsAbout: [
    'Geospatial data engineering',
    'Data engineering',
    'Data science',
    'Machine learning',
    'Natural language processing',
    'Embedded systems',
    '3D printing',
  ],
  sameAs,
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#08080a" />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">TV</span>
          <span>{site.name}</span>
        </a>
        <nav class="nav-links" aria-label="Rooms">
          <a href="/#work">Work</a>
          <a href="/#lab">Lab</a>
          <a href="/#sound">Sound</a>
          <a href="/#japan">Japan</a>
          <a href="/#play">Play</a>
        </nav>

        <a class="nav-cta" href={navCtaHref} target={onCv ? '_blank' : undefined} rel={onCv ? 'noopener noreferrer' : undefined}>
          <span class="nav-cta-full">{navCtaLabel}</span>
          <span class="nav-cta-short">{navCtaShort}</span>
          <span aria-hidden="true">↗</span>
        </a>

        <details class="nav-mobile">
          <summary aria-label="Open menu">
            Menu
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M3 6l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="nav-mobile-panel">
            <a href="/#work">Work</a>
            <a href="/#lab">Lab</a>
            <a href="/#sound">Sound</a>
            <a href="/#japan">Japan</a>
            <a href="/#play">Play</a>
            <a href="/#about">About</a>
            <a href="/cv">CV &amp; experience</a>
            <a href="/#contact">Contact</a>
          </div>
        </details>
      </div>
      <div class="scroll-progress" aria-hidden="true"></div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <span class="mono">© {new Date().getFullYear()} {site.name}</span>
        <span class="mono footer-links">
          <a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span class="footer-sep" aria-hidden="true">·</span>
          <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <span class="footer-sep" aria-hidden="true">·</span>
          <a href={links.blog} target="_blank" rel="noopener noreferrer">Blog</a>
          <span class="footer-sep" aria-hidden="true">·</span>
          <a href="/cv">CV</a>
          <span class="footer-sep" aria-hidden="true">·</span>
          <a href="/#contact">Contact</a>
        </span>
      </div>
    </footer>

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const coarse = window.matchMedia('(pointer: coarse)').matches;

      // 1. Staggered scroll reveals
      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduced || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                const target = entry.target as HTMLElement;
                const delay = target.dataset.delay;
                if (delay) {
                  target.style.setProperty('--reveal-delay', `${delay}ms`);
                }
                target.classList.add('is-in');
                io.unobserve(target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.05 },
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // 2. Scroll progress hairline
      const progressEl = document.querySelector<HTMLElement>('.scroll-progress');
      if (progressEl) {
        let ticking = false;
        const updateProgress = () => {
          ticking = false;
          const doc = document.documentElement;
          const scrollable = doc.scrollHeight - doc.clientHeight;
          const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
          progressEl.style.setProperty('--scroll-progress', ratio.toFixed(4));
        };
        updateProgress();
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(updateProgress);
            }
          },
          { passive: true },
        );
      }

      // 3. Active nav section spy
      const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-links a[href^="/#"]'));
      const sections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));
      if (navLinks.length > 0 && sections.length > 0 && 'IntersectionObserver' in window) {
        const setActive = (id: string) => {
          for (const link of navLinks) {
            const matches = link.getAttribute('href') === `/#${id}`;
            link.classList.toggle('is-active', matches);
            if (matches) {
              link.setAttribute('aria-current', 'location');
            } else {
              link.removeAttribute('aria-current');
            }
          }
        };

        const visible = new Map<string, number>();
        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const id = entry.target.id;
              if (entry.isIntersecting) {
                visible.set(id, entry.intersectionRatio);
              } else {
                visible.delete(id);
              }
            }
            if (visible.size > 0) {
              let bestId = '';
              let bestRatio = -1;
              for (const [id, ratio] of visible.entries()) {
                if (ratio > bestRatio) {
                  bestRatio = ratio;
                  bestId = id;
                }
              }
              if (bestId) setActive(bestId);
            }
          },
          { rootMargin: '-28% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75] },
        );
        sections.forEach((sec) => spy.observe(sec));
      }

      // 4. Cursor spotlight tracking
      if (!reduced && !coarse) {
        document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
          card.addEventListener(
            'pointermove',
            (e) => {
              const rect = card.getBoundingClientRect();
              const x = ((e.clientX - rect.left) / rect.width) * 100;
              const y = ((e.clientY - rect.top) / rect.height) * 100;
              card.style.setProperty('--mx', `${x.toFixed(1)}%`);
              card.style.setProperty('--my', `${y.toFixed(1)}%`);
            },
            { passive: true },
          );
        });
      }

      // 5. Count-up stats
      const countEls = document.querySelectorAll<HTMLElement>('[data-count]');
      const formatCount = (num: number, decimals: number, suffix: string) =>
        `${decimals > 0 ? num.toFixed(decimals) : Math.round(num)}${suffix}`;

      if (reduced || !('IntersectionObserver' in window)) {
        countEls.forEach((el) => {
          const target = Number(el.dataset.count ?? '0');
          const decimals = Number(el.dataset.decimals ?? '0');
          const suffix = el.dataset.suffix ?? '';
          if (!Number.isNaN(target)) el.textContent = formatCount(target, decimals, suffix);
        });
      } else {
        const countIo = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              countIo.unobserve(el);
              const target = Number(el.dataset.count ?? '0');
              const decimals = Number(el.dataset.decimals ?? '0');
              const suffix = el.dataset.suffix ?? '';
              if (Number.isNaN(target)) continue;
              const duration = 900;
              const start = performance.now();
              const step = (now: number) => {
                const t = Math.min(1, (now - start) / duration);
                const eased = 1 - Math.pow(1 - t, 3);
                el.textContent = formatCount(target * eased, decimals, suffix);
                if (t < 1) {
                  requestAnimationFrame(step);
                } else {
                  el.textContent = formatCount(target, decimals, suffix);
                }
              };
              requestAnimationFrame(step);
            }
          },
          { threshold: 0.35 },
        );
        countEls.forEach((el) => countIo.observe(el));
      }

      // 6. Mobile menu auto-close
      const mobileMenu = document.querySelector<HTMLDetailsElement>('.nav-mobile');
      if (mobileMenu) {
        mobileMenu.querySelectorAll('.nav-mobile-panel a').forEach((link) => {
          link.addEventListener('click', () => {
            mobileMenu.open = false;
          });
        });
      }
    </script>
  </body>
</html>
