---
import type { CollectionEntry } from 'astro:content';
import WorkDiagram from './diagrams/WorkDiagram.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  delay?: number;
}

const { entry, delay = 0 } = Astro.props;
const { title, kicker, year, diagram, live } = entry.data;
const caseStudy = `/work/${entry.id}/`;
---

<article class="lab-card" data-spotlight data-reveal data-delay={String(delay)}>
  <div class="lab-visual">
    <WorkDiagram slug={entry.id} diagram={diagram} title={title} mode="card" />
    <span class:list={['lab-badge', { 'is-live': Boolean(live) }]}>{live ? 'Live tool' : 'Case study'}</span>
  </div>

  <div class="lab-body">
    <div class="lab-head">
      <span>{kicker}</span>
      <span>{year}</span>
    </div>
    <h3>{title}</h3>
    <div class="lab-actions">
      {live && (
        <a class="btn btn--sm" href={live} target="_blank" rel="noopener noreferrer">
          Try it live ↗
        </a>
      )}
      <a class="lab-link" href={caseStudy}>
        {live ? 'How it works' : 'Read the full study'} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
