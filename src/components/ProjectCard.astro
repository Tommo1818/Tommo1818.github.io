---
import type { CollectionEntry } from 'astro:content';
import WorkDiagram from './diagrams/WorkDiagram.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  index: number;
}

const { entry, index } = Astro.props;
const { title, summary, kicker, year, stack, live, repo, diagram } = entry.data;
const href = `/work/${entry.id}/`;
---

<article class="card card--story" data-spotlight data-reveal data-delay={String((index - 1) * 80)}>
  {diagram && (
    <a class="card-media" href={href} aria-label={`Read the ${title} case study`}>
      <WorkDiagram slug={entry.id} diagram={diagram} title={title} mode="card" />
    </a>
  )}

  <div class="card-top">
    <span class="card-kicker">{kicker}</span>
    <span class="card-index">{String(index).padStart(2, '0')} · {year}</span>
  </div>

  <h3><a class="card-title" href={href}>{title}</a></h3>
  <p>{summary}</p>
  <p class="card-stack">{stack.join(' · ')}</p>

  <div class="card-foot">
    <span class="links">
      {live && <a href={live} target="_blank" rel="noopener noreferrer">Live ↗</a>}
      {repo && <a href={repo} target="_blank" rel="noopener noreferrer">Code ↗</a>}
    </span>
    <a class="more" href={href}>Read the build <span aria-hidden="true">→</span></a>
  </div>
</article>
