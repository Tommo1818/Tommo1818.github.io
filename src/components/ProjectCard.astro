---
import type { CollectionEntry } from 'astro:content';
import WorkDiagram from './diagrams/WorkDiagram.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  index: number;
}

const { entry, index } = Astro.props;
const { title, summary, kicker, year, stack, live, repo, diagram } = entry.data;
const href = `/work/${entry.id}/`;
---

<article class="card" data-spotlight data-reveal data-delay={String((index - 1) * 80)}>
  {diagram && (
    <div class="card-media">
      <WorkDiagram slug={entry.id} diagram={diagram} title={title} mode="card" />
      {live && (
        <span class="card-live-badge">
          <span class="card-live-dot" aria-hidden="true"></span>
          Live
        </span>
      )}
    </div>
  )}

  <div class="card-top">
    <span class="card-kicker">{kicker}</span>
    <span class="card-index">{String(index).padStart(2, '0')} · {year}</span>
  </div>

  <h3><a class="card-title" href={href}>{title}</a></h3>
  <p>{summary}</p>
  <p class="card-stack">{stack.join(' · ')}</p>

  <div class="card-actions">
    {live && (
      <a class="btn btn--sm" href={live} target="_blank" rel="noopener noreferrer">Try it live ↗</a>
    )}
    {repo && (
      <a class="card-minilink" href={repo} target="_blank" rel="noopener noreferrer">Code ↗</a>
    )}
    <a class="card-title-link" href={href}>Read the build <span aria-hidden="true">→</span></a>
  </div>
</article>
