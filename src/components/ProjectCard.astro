---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  index: number;
}

const { entry, index } = Astro.props;
const { title, summary, kicker, year, stack, live, repo, diagram } = entry.data;
const href = `/work/${entry.id}/`;
---

<article class="card">
  {diagram && (
    <div class="card-media">
      <img src={diagram} alt="" width="640" height="360" loading="lazy" decoding="async" />
    </div>
  )}

  <div class="card-top">
    <span class="card-kicker">{kicker}</span>
    <span class="card-index">{String(index).padStart(2, '0')} · {year}</span>
  </div>

  <h3><a class="stretch" href={href}>{title}</a></h3>
  <p>{summary}</p>

  <div class="card-chips">
    {stack.map((item) => <span class="chip">{item}</span>)}
  </div>

  <div class="card-foot">
    <span class="links">
      {live && <a href={live} target="_blank" rel="noopener noreferrer">Live ↗</a>}
      {repo && <a href={repo} target="_blank" rel="noopener noreferrer">Code ↗</a>}
    </span>
    <span class="more">Case study <span aria-hidden="true">→</span></span>
  </div>
</article>
